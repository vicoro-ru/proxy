global
    log stdout format raw local0
    maxconn 4096

defaults
    log     global
    option  httplog
    option  dontlognull
    option  log-health-checks
    timeout connect 10s
    timeout client  50s
    timeout server  50s

frontend privoxy_in
    bind *:8118
    mode tcp
    option tcplog
    default_backend tor_privoxy_pool

backend tor_privoxy_pool
    mode tcp
    balance source
    option httpchk GET http://check.torproject.org/
    http-check send hdr Host check.torproject.org
    server-template proxy 50 tasks.tor:8118 check resolvers docker init-addr none
    resolvers docker
        parse-resolv-conf
        hold valid 10s
