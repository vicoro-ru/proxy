global
    log stdout format raw local0
    maxconn 8192

defaults
    log global
    option tcplog
    timeout connect 5s
    timeout client  1h
    timeout server  1h
    retries 2
    option redispatch
    option abortonclose

frontend privoxy_in
    bind *:8118
    mode tcp
    option tcplog
    default_backend privoxy_pool

backend privoxy_pool
    mode tcp
    balance source
    option tcp-check
    option tcp-smart-connect
    tcp-check connect
    server-template proxy 50 tasks.tor:8118 check resolvers docker init-addr none maxconn 35
    resolvers docker
        parse-resolv-conf
        hold valid 10s
